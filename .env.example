# 可选：32 字节随机密钥的 Base64 表示。未设置时，本地开发会生成 .data/master.key。
# KALENDER_MASTER_KEY=

# 可选：覆盖本地数据目录。默认使用项目根目录的 .data。
# KALENDER_DATA_DIR=

# 可选：后台邮箱同步间隔（毫秒），最小 30000；默认 180000（3 分钟）。
# KALENDER_SYNC_INTERVAL_MS=180000

# 可选：邮件正文缓存有效期（天）和容量上限（MB）；默认 30 天、128 MB。
# KALENDER_MAIL_BODY_CACHE_MAX_AGE_DAYS=30
# KALENDER_MAIL_BODY_CACHE_MAX_MB=128

# Comma-separated hostnames or LAN IPs allowed to access the Next.js dev server.
KALENDER_ALLOWED_DEV_ORIGINS=192.168.178.49
