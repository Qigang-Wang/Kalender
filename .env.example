# 可选：32 字节随机密钥的 Base64 表示。未设置时，本地开发会生成 .data/master.key。
# KALENDER_MASTER_KEY=

# 可选：覆盖本地数据目录。默认使用项目根目录的 .data，用于附件和本地文件。
# KALENDER_DATA_DIR=

# 可选：备份文件目录。默认使用 KALENDER_DATA_DIR/postgres-backups。
# KALENDER_BACKUP_DIR=

# 可选：上传/恢复备份文件大小上限（字节）。当前应用默认 512 MB。
# KALENDER_BACKUP_MAX_BYTES=536870912

# 必填：PostgreSQL 连接字符串。
# DATABASE_URL=postgresql://kalender:password@localhost:5432/kalender

# Docker Compose 的 PostgreSQL 密码。生产环境请改为强随机值。
# KALENDER_POSTGRES_PASSWORD=

# 可选：首次初始化时的后台同步间隔（毫秒）；之后可在“设置 > 同步”中修改。
# KALENDER_SYNC_INTERVAL_MS=180000
# KALENDER_CALENDAR_SYNC_INTERVAL_MS=180000

# 可选：应用内任务队列轮询间隔（毫秒）；默认 5000。
# KALENDER_JOB_POLL_INTERVAL_MS=5000

# 可选：是否允许 AI 自动执行入口。用户级开关仍需在设置中开启。
# KALENDER_AI_AUTO_EXECUTION=false

# 可选：健康检查令牌。未设置时 /api/health 公开返回轻量状态。
# KALENDER_HEALTHCHECK_TOKEN=

# 可选：MCP Bearer 令牌每分钟请求上限（默认 120）和无效令牌 IP 上限（默认 20）。
# KALENDER_MCP_TOKEN_REQUESTS_PER_MINUTE=120
# KALENDER_MCP_INVALID_TOKEN_REQUESTS_PER_MINUTE=20
# 可选：仅在受信反向代理会覆盖 X-Real-IP/X-Forwarded-For 时设为 true；默认使用匿名桶。
# KALENDER_MCP_TRUST_PROXY_IP_HEADERS=false
# 可选：允许访问 MCP 的 Host（忽略端口），多个值使用逗号分隔；默认仅允许 localhost、127.0.0.1 和 ::1。
# KALENDER_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,dayline.example.com
# 可选：允许浏览器 MCP 客户端使用的完整 Origin，多个值使用逗号分隔；默认拒绝所有带 Origin 的请求。
# KALENDER_MCP_ALLOWED_ORIGINS=https://client.example.com

# 可选：邮件正文缓存有效期（天）和容量上限（MB）；默认 30 天、128 MB。
# KALENDER_MAIL_BODY_CACHE_MAX_AGE_DAYS=30
# KALENDER_MAIL_BODY_CACHE_MAX_MB=128

# 可选：允许访问 Next.js 开发服务器的主机名或局域网 IP，多个值使用逗号分隔。
# KALENDER_ALLOWED_DEV_ORIGINS=192.168.1.10
