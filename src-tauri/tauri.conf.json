{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalender",
  "version": "0.1.5",
  "identifier": "com.kalender.desktop",
  "build": {
    "frontendDist": "desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "remote-main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Kalender desktop reminders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
