{
  "name": "personal-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/realtime-gateway.mjs --dev",
    "dev:next": "npm run dev --workspace @workspace/web",
    "build": "npm run check:ui-dialogs && npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "npm run build --workspace @workspace/web",
    "db:migrations:status": "tsx apps/web/src/server/migration-status.ts",
    "typecheck": "npm run check:ui-dialogs && npm run typecheck:core && npm run typecheck:web",
    "check:ui-dialogs": "node scripts/check-native-dialogs.mjs",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck --workspace @workspace/web",
    "test": "node scripts/run-tests.mjs",
    "test:serial": "npm run test:core && npm run test:storage && npm run test:auth && npm run test:database-migrations && npm run test:backup && npm run test:imap-sync-state && npm run test:ai-provider && npm run test:ai-chat && npm run test:mail-ai && npm run test:mail-body && npm run test:mail-drafts && npm run test:mail-signatures && npm run test:mail-reply && npm run test:mail-date-groups && npm run test:mail-smime && npm run test:context-commands && npm run test:calendar && npm run test:calendar-sync-scheduler && npm run test:caldav && npm run test:exchange && npm run test:exchange-mail && npm run test:ics && npm run test:tasks && npm run test:projects && npm run test:notes && npm run test:links && npm run test:today && npm run test:search && npm run test:http-client",
    "test:core": "npm run build:core && node dist/test/run.js",
    "test:storage": "tsx apps/web/src/server/storage.test.ts",
    "test:auth": "tsx apps/web/src/server/auth.test.ts",
    "test:database-migrations": "tsx apps/web/src/server/database-migrations.test.ts",
    "test:backup": "tsx apps/web/src/server/backup-service.test.ts",
    "test:imap-sync-state": "tsx apps/web/src/server/imap-sync-state.test.ts",
    "test:ai-provider": "tsx apps/web/src/server/ai-provider.test.ts",
    "test:ai-chat": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/server/ai-chat.test.ts",
    "test:mail-ai": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/server/mail-ai.test.ts",
    "test:mail-body": "tsx apps/web/src/server/mail-body.test.ts",
    "test:mail-drafts": "tsx apps/web/src/server/mail-draft.test.ts",
    "test:mail-signatures": "tsx apps/web/src/lib/mail-signature-content.test.ts",
    "test:mail-reply": "tsx apps/web/src/lib/mail-reply-recipients.test.ts",
    "test:mail-date-groups": "tsx apps/web/src/lib/mail-date-groups.test.ts",
    "test:mail-smime": "tsx apps/web/src/lib/mail-smime.test.ts",
    "test:context-commands": "tsx apps/web/src/components/context-commands.test.ts",
    "test:task-view": "tsx apps/web/src/components/pages/task-view-model.test.ts",
    "test:calendar": "tsx apps/web/src/server/calendar.test.ts",
    "test:calendar-sync-scheduler": "tsx apps/web/src/server/calendar-sync-scheduler.test.ts",
    "test:caldav": "tsx apps/web/src/server/caldav.test.ts",
    "test:exchange": "tsx apps/web/src/server/exchange-calendar.test.ts",
    "test:exchange-mail": "tsx apps/web/src/server/exchange-mail.test.ts",
    "test:ics": "tsx apps/web/src/server/ics-subscription.test.ts",
    "test:tasks": "tsx apps/web/src/server/task.test.ts",
    "test:projects": "tsx apps/web/src/server/project.test.ts",
    "test:notes": "tsx apps/web/src/server/note.test.ts && tsx apps/web/src/lib/note-content.test.ts",
    "test:links": "tsx apps/web/src/server/entity-link.test.ts",
    "test:today": "tsx apps/web/src/server/today.test.ts",
    "test:search": "tsx apps/web/src/server/workspace-search.test.ts",
    "test:http-client": "tsx apps/web/src/lib/fetch-with-timeout.test.ts",
    "test:desktop-reminders": "tsx apps/web/src/lib/desktop-reminders.test.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@types/pg": "^8.21.0",
    "ical.js": "^2.2.1",
    "imapflow": "^1.7.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "postal-mime": "^3.0.0",
    "sanitize-html": "2.17.6",
    "ws": "^8.21.3"
  }
}
