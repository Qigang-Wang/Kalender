# 浏览器访问端口。修改后使用 http://飞牛IP:新端口 访问。
KALENDER_HTTP_PORT=3000
TZ=Europe/Berlin

# 使用 `openssl rand -hex 24` 生成。只使用十六进制，避免连接 URL 转义问题。
KALENDER_POSTGRES_PASSWORD=替换为数据库密码

# 使用 `openssl rand -base64 32` 生成。必须永久保存，丢失后无法解密账户凭据。
KALENDER_MASTER_KEY=替换为Base64主密钥

# 使用 `openssl rand -hex 24` 生成。自动加密备份需要该密码。
KALENDER_BACKUP_PASSWORD=替换为备份密码

# 以下通常保持默认即可，也可以在应用的“设置 > 同步”中调整同步策略。
KALENDER_BACKUP_MAX_BYTES=536870912
KALENDER_SYNC_INTERVAL_MS=180000
KALENDER_CALENDAR_SYNC_INTERVAL_MS=180000
KALENDER_JOB_POLL_INTERVAL_MS=5000
KALENDER_AI_AUTO_EXECUTION=false
KALENDER_MAIL_BODY_CACHE_MAX_AGE_DAYS=30
KALENDER_MAIL_BODY_CACHE_MAX_MB=128
